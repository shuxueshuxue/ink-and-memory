# BACKEND_URL is injected at container startup via envsubst.
# Local docker-compose: BACKEND_URL=http://ink-backend:8765
# Cloud Run:            BACKEND_URL=<backend run.app service URL> as proxy fallback.
# Browser API calls use runtime-config API_BASE_URL=https://ink-backend.suoxya.com.
# [Sync] 2026-06-14: proxy root/base robots.txt, sitemap.xml, and llms.txt to backend SEO generators.
# [Sync] 2026-06-15: include Docker embedded DNS so variable proxy_pass can resolve ink-backend in Compose.
# [Sync] 2026-06-15: remove /ink-and-memory/ deployment prefix; serve SPA and fallback APIs at root.
# [Sync] 2026-06-23: add auth/OAuth same-origin fallback proxies while keeping
#                    /oauth/device/verify as an SPA route.
server {
    listen 80;
    server_name _;

    # Required for variable proxy_pass. Docker Compose service names resolve via
    # 127.0.0.11; public DNS remains for Cloud Run / external backend URLs.
    resolver 127.0.0.11 8.8.8.8 8.8.4.4 valid=60s ipv6=off;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1024;

    # Machine-readable SEO files are generated by the backend so public URLs can
    # follow INK_PUBLIC_BASE_URL across local, Remote SSH, and Cloud Run.
    location ~ ^/(robots\.txt|sitemap\.xml|llms\.txt)$ {
        set $backend "${BACKEND_URL}";
        proxy_pass         $backend/$1;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=300" always;
    }

    # Runtime API config and SPA HTML must never be cached; they change per
    # deployment and control whether the browser calls the Cloud Run backend
    # directly. Fingerprinted assets stay immutable below.
    location = /runtime-config.js {
        alias /usr/share/nginx/html/runtime-config.js;
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # ── API proxy ──────────────────────────────────────────────────────────
    # Static proxy_pass with path doesn't work when the upstream hostname is
    # dynamic (Cloud Run URL), so this keeps the URI and uses variable upstream.
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass         $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # SSE / long-polling
        proxy_set_header   Connection        "";
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /auth/ {
        set $backend "${BACKEND_URL}";
        proxy_pass         $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /oauth/google/ {
        set $backend "${BACKEND_URL}";
        proxy_pass         $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location = /oauth/device/code {
        set $backend "${BACKEND_URL}";
        proxy_pass         $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location = /oauth/token {
        set $backend "${BACKEND_URL}";
        proxy_pass         $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /polycli/ {
        set $backend "${BACKEND_URL}";
        proxy_pass         $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── Static SPA ─────────────────────────────────────────────────────────
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable" always;
        }
    }
}
